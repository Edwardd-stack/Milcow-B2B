# Copy to .env.local:  cp .env.example .env.local
# NEXT_PUBLIC_ variables are sent to the browser — never put secrets here.

# NestJS API origin (apps/api). Server-only: the browser goes through the /api/v1 proxy in next.config.ts.
# Optional locally — defaults to http://localhost:3000
API_ORIGIN=http://localhost:3000

# Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키 (public, restricted by domain)
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key

# Toss Payments → 개발자센터 → API 키 → API 개별 연동 키 → 클라이언트 키 (test_ck_…). Public key.
# Must be the pair of TOSS_SECRET_KEY in apps/api/.env
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
