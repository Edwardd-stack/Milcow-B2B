# Copy to .env:  cp .env.example .env

NODE_ENV=development
PORT=3000

# Local PostgreSQL from docker-compose.yml (used by Prisma in the next tasks)
DATABASE_URL=postgresql://milcow:milcow@localhost:5432/milcow?schema=public

# Frontends allowed to call the API (comma-separated): web (3001), admin (3002)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# JWT — secret must be long and random (at least 32 characters). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SEC=604800

# Toss Payments — developers.tosspayments.com → API 키 → API 개별 연동 키 (test_sk_...)
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — aistudio.google.com → Get API key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Web app origin (OAuth redirect URIs are built from it)
WEB_ORIGIN=http://localhost:3001

# Kakao login — developers.kakao.com → 앱 키 → REST API 키; 보안 → Client Secret
# Redirect URI to register: http://localhost:3001/api/v1/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Google login — console.cloud.google.com → Credentials → OAuth client ID (Web application)
# Redirect URI to register: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Try the demo" button + nightly demo-data reset (set to false to turn both off)
DEMO_ENABLED=true

# Seed only: password for all seeded accounts. Use a strong one when seeding a deployed database.
# SEED_PASSWORD=
