# Copy to .env:  cp .env.example .env

NODE_ENV=development
PORT=3000

# Local PostgreSQL from docker-compose.yml (used by Prisma in the next tasks)
DATABASE_URL=postgresql://milcow:milcow@localhost:5432/milcow?schema=public

# Frontends allowed to call the API (comma-separated): web (3001), admin (3002)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
