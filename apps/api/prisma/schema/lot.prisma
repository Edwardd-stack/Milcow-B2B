enum BacteriaGrade {
  GRADE_1A // < 30,000 /mL
  GRADE_1B
  GRADE_2
  GRADE_3
  GRADE_4

  @@map("bacteria_grade")
}

enum SomaticGrade {
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5

  @@map("somatic_grade")
}

enum AntibioticResult {
  NEGATIVE
  POSITIVE

  @@map("antibiotic_result")
}

enum LotStatus {
  IN_STOCK
  SOLD_OUT
  EXPIRED

  @@map("lot_status")
}

// One batch of raw milk / dairy: where it came from, lab results, cold-chain log (원유 품질 여권).
// Demo data is generated by the seed and a daily job.
model Lot {
  id      String    @id @default(uuid(7)) @db.Uuid
  lotCode String    @unique @map("lot_code") // ML-20261113-ICN-07
  lotStatus LotStatus @default(IN_STOCK) @map("lot_status")

  // Timeline
  lotMilkedAt    DateTime @map("lot_milked_at") @db.Timestamptz(3)
  lotCollectedAt DateTime @map("lot_collected_at") @db.Timestamptz(3)
  lotArrivedAt   DateTime @map("lot_arrived_at") @db.Timestamptz(3) // at the warehouse
  lotUseBy       DateTime @map("lot_use_by") @db.Timestamptz(3) // must be processed before this

  // Volume
  lotVolumeTon    Decimal @map("lot_volume_ton") @db.Decimal(10, 2)
  lotRemainingTon Decimal @map("lot_remaining_ton") @db.Decimal(10, 2)

  // Lab results
  lotBacteriaCount Int              @map("lot_bacteria_count") // per mL
  lotBacteriaGrade BacteriaGrade    @map("lot_bacteria_grade")
  lotSomaticCount  Int              @map("lot_somatic_count") // per mL
  lotSomaticGrade  SomaticGrade     @map("lot_somatic_grade")
  lotFatPct        Decimal          @map("lot_fat_pct") @db.Decimal(4, 2)
  lotProteinPct    Decimal          @map("lot_protein_pct") @db.Decimal(4, 2)
  lotAntibiotic    AntibioticResult @default(NEGATIVE) @map("lot_antibiotic")

  lotTempLog Json    @map("lot_temp_log") // [{ at, c, stage }]
  lotCo2eKg  Decimal @map("lot_co2e_kg") @db.Decimal(10, 1) // estimate

  // Surplus exchange (잉여 원유 매칭)
  lotIsSurplus       Boolean @default(false) @map("lot_is_surplus")
  lotBasePricePerTon Int     @map("lot_base_price_per_ton") // KRW, before the freshness discount

  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  farmId      String    @map("farm_id") @db.Uuid
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Restrict)
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lotIsSurplus, lotStatus, lotUseBy])
  @@index([productId])
  @@index([farmId])
  @@index([warehouseId])
  @@map("lots")
}
