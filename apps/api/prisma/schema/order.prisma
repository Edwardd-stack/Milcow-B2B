enum OrderStatus {
  PENDING // created, waiting for payment
  PAID
  PREPARING
  SHIPPING // DELIVERY only
  READY_FOR_PICKUP // PICKUP only
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum DeliveryType {
  DELIVERY // Milcow delivers to the buyer's address
  PICKUP // buyer picks up at a warehouse

  @@map("delivery_type")
}

model Order {
  id                 String       @id @default(uuid(7)) @db.Uuid
  orderStatus        OrderStatus  @default(PENDING) @map("order_status")
  orderDeliveryType  DeliveryType @map("order_delivery_type")
  orderAddress       String?      @map("order_address") // DELIVERY only
  orderScheduledDate DateTime?    @map("order_scheduled_date") @db.Date
  orderServiceFee    Decimal      @default(0) @map("order_service_fee") @db.Decimal(15, 0) // KRW, contract add-on services
  orderTotal         Decimal      @map("order_total") @db.Decimal(15, 0) // KRW, products + service fee
  orderHoldUntil     DateTime?    @map("order_hold_until") @db.Timestamptz(3) // surplus reservation: unpaid after this → cancelled

  memberId    String    @map("member_id") @db.Uuid
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  warehouseId String    @map("warehouse_id") @db.Uuid // ships from / pickup at
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // Set when the order was generated monthly by a contract
  contractId String?   @map("contract_id") @db.Uuid
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  pickup   Pickup?
  events   OrderEvent[]
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([contractId, orderScheduledDate]) // a contract creates at most one order per date (safe cron re-runs)
  @@index([memberId, orderStatus])
  @@index([warehouseId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  itemTon         Decimal @map("item_ton") @db.Decimal(10, 2)
  itemPricePerTon Int     @map("item_price_per_ton") // price at order time (snapshot)

  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Which milk lot this line comes from (surplus purchases, passport link). Optional.
  lotId String? @map("lot_id") @db.Uuid
  lot   Lot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId]) // one line per product in an order
  @@index([lotId])
  @@index([productId])
  @@map("order_items")
}

enum OrderEventType {
  CREATED
  STATUS_CHANGED
  CANCELLED
  REFUNDED
  PICKUP_STEP

  @@map("order_event_type")
}

// Order history: who changed what and when (shown as a timeline in the admin console)
model OrderEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  eventType OrderEventType @map("event_type")
  eventFrom String?        @map("event_from") // previous status
  eventTo   String?        @map("event_to") // new status
  eventNote String?        @map("event_note") // e.g. cancel reason

  orderId  String  @map("order_id") @db.Uuid
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  memberId String? @map("member_id") @db.Uuid // null = system (cron, payment webhook)
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_events")
}
